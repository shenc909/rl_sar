<?xml version="1.0"?>
<package format="2">
    <name>rl_sar</name>
    <version>3.0.0</version>
    <description>The rl_sar package</description>

    <maintainer email="fanziqi614@gmail.com">Ziqi Fan</maintainer>

    <license>Apache-2.0</license>

    <!--
        Per-target dependency compartmentalization via REP-149 conditions.
        TARGET_ROBOT is exported by build.sh before invoking catkin; an
        unset/empty value (the bare `./build.sh` full build) hits the `== ''`
        branch and includes everything. Per-target `./build.sh -r <target>`
        only resolves the deps relevant to that executable's CMake block.
    -->

    <buildtool_depend>catkin</buildtool_depend>
    <buildtool_depend>genmsg</buildtool_depend>

    <!-- Universal: every executable links rl_sdk and ROS-side messaging. -->
    <depend>roscpp</depend>
    <depend>std_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>robot_msgs</depend>

    <!-- rl_sim (Gazebo) — full build or `-r sim`. -->
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'sim'">controller_manager</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'sim'">joint_state_controller</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'sim'">robot_state_publisher</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'sim'">gazebo_ros</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'sim'">tf</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'sim'">robot_joint_controller</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'sim'">rospy</depend>

    <export>

    </export>
</package>
