<?xml version="1.0"?>
<package format="3">
    <name>rl_sar</name>
    <version>3.0.0</version>
    <description>The rl_sar package</description>

    <maintainer email="fanziqi614@gmail.com">Ziqi Fan</maintainer>

    <license>Apache-2.0</license>

    <!--
        Per-target dependency compartmentalization via REP-149 conditions.
        TARGET_ROBOT is exported by build.sh before invoking colcon; an
        unset/empty value (the bare `./build.sh` full build) hits the `== ''`
        branch and includes everything. Per-target `./build.sh -r <target>`
        only resolves the deps relevant to that executable's CMake block.
    -->

    <buildtool_depend>ament_cmake</buildtool_depend>

    <!-- Universal: every executable links rl_sdk which uses these. -->
    <depend>rclcpp</depend>
    <depend>std_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>robot_msgs</depend>
    <depend>yaml-cpp</depend>

    <!-- rl_sim (Gazebo) — full build or `-r gazebo`. -->
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'gazebo'">gazebo_ros</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'gazebo'">gazebo_msgs</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'gazebo'">controller_manager</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'gazebo'">joint_state_controller</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'gazebo'">robot_state_publisher</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'gazebo'">robot_joint_controller</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'gazebo'">std_srvs</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'gazebo'">rclpy</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'gazebo'">rospy</depend>

    <!-- sensor_msgs is needed by rl_real_go2_ros2 and rl_real_quickbot. -->
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'go2' or $TARGET_ROBOT == 'quickbot'">sensor_msgs</depend>

    <!-- rl_real_go2_ros2 (Unitree's ROS2 msg packages) — full build or `-r go2`. -->
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'go2'">unitree_go</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'go2'">unitree_hg</depend>
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'go2'">unitree_api</depend>

    <!-- rl_real_quickbot (unitree-free Go2) — full build or `-r quickbot`. -->
    <depend condition="$TARGET_ROBOT == '' or $TARGET_ROBOT == 'quickbot'">quickbot_interface</depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
